{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@syncnotes/types": ["../../shared/types/src/index.ts"],
      "@syncnotes/types/*": ["../../shared/types/src/*"],
      "@syncnotes/utils": ["../../shared/utils/src/index.ts"],
      "@syncnotes/utils/*": ["../../shared/utils/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "electron/**/*",
    "../../shared/types/src/**/*",
    "../../shared/utils/src/**/*"
  ]
}
